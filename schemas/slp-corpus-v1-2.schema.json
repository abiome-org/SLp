{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abiome.org/schemas/slp-corpus-v1-2.schema.json",
  "title": "SLp composite-keyed typed sparse molecular corpus snapshot",
  "type": "object",
  "required": [
    "schema",
    "datasetId",
    "version",
    "role",
    "labelClass",
    "benchmarkLabelsPresent",
    "rewardEnabled",
    "identityKey",
    "rights",
    "modalities",
    "sources",
    "sampling",
    "species",
    "featurePack",
    "entityTypes",
    "contextTypes",
    "actionTypes",
    "covariates",
    "readoutTypes",
    "entityDictionary",
    "queryDictionary",
    "queryPanels",
    "trajectoryInterventions",
    "normalization",
    "bounds",
    "counts",
    "shards",
    "inputs"
  ],
  "properties": {
    "schema": {"const": "slp.corpus/v1.2"},
    "datasetId": {"$ref": "#/$defs/curie"},
    "version": {"type": "string", "minLength": 1},
    "role": {"const": "pretrain"},
    "labelClass": {"const": "molecular"},
    "benchmarkLabelsPresent": {"const": false},
    "rewardEnabled": {"const": false},
    "identityKey": {
      "type": "array",
      "const": ["ncbiTaxon", "entityId"]
    },
    "rights": {
      "type": "object",
      "required": ["revision", "trainingAllowed", "redistributionAllowed"],
      "properties": {
        "revision": {"$ref": "#/$defs/curie"},
        "trainingAllowed": {"const": true},
        "redistributionAllowed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "modalities": {"$ref": "#/$defs/curieList"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"$ref": "#/$defs/curie"}
        },
        "additionalProperties": false
      }
    },
    "sampling": {
      "type": "object",
      "required": ["scheme", "sourceWeights"],
      "properties": {
        "scheme": {"const": "slp.source-intervention-replicate-record/v1"},
        "sourceWeights": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      },
      "additionalProperties": false
    },
    "species": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["taxon", "featureValue", "featurePresent"],
        "properties": {
          "taxon": {"type": "integer", "minimum": 1},
          "featureValue": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "number"}
          },
          "featurePresent": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "boolean"}
          }
        },
        "additionalProperties": false
      }
    },
    "featurePack": {"$ref": "#/$defs/staticFeaturePack"},
    "entityTypes": {"$ref": "#/$defs/curieList"},
    "contextTypes": {"$ref": "#/$defs/curieList"},
    "actionTypes": {"$ref": "#/$defs/curieList"},
    "covariates": {
      "type": "object",
      "required": ["record", "context", "action", "observation"],
      "properties": {
        "record": {"$ref": "#/$defs/covariateList"},
        "context": {"$ref": "#/$defs/covariateList"},
        "action": {"$ref": "#/$defs/covariateList"},
        "observation": {"$ref": "#/$defs/covariateList"}
      },
      "additionalProperties": false
    },
    "readoutTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "likelihood", "unit", "implicitZero"],
        "properties": {
          "id": {"$ref": "#/$defs/curie"},
          "likelihood": {"enum": ["gaussian", "negative-binomial"]},
          "unit": {"$ref": "#/$defs/curie"},
          "implicitZero": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "entityDictionary": {"$ref": "#/$defs/fileReference"},
    "queryDictionary": {"$ref": "#/$defs/fileReference"},
    "queryPanels": {"$ref": "#/$defs/fileReference"},
    "trajectoryInterventions": {"$ref": "#/$defs/possiblyEmptyFileReference"},
    "normalization": {
      "type": "object",
      "required": ["id", "valueSpace"],
      "properties": {
        "id": {"$ref": "#/$defs/curie"},
        "valueSpace": {"$ref": "#/$defs/curie"}
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": [
        "maxRecordsPerShard",
        "maxContextTokens",
        "maxActionTokens",
        "maxPanelQueries",
        "maxTargetsPerRecord"
      ],
      "properties": {
        "maxRecordsPerShard": {"type": "integer", "minimum": 1},
        "maxContextTokens": {"type": "integer", "minimum": 1},
        "maxActionTokens": {"type": "integer", "minimum": 1},
        "maxPanelQueries": {"type": "integer", "minimum": 1},
        "maxTargetsPerRecord": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "entities",
        "featureRows",
        "contexts",
        "queries",
        "panels",
        "trajectoryInterventions",
        "records",
        "targetValues",
        "shards"
      ],
      "properties": {
        "entities": {"type": "integer", "minimum": 1},
        "featureRows": {"type": "integer", "minimum": 1},
        "contexts": {"type": "integer", "minimum": 1},
        "queries": {"type": "integer", "minimum": 1},
        "panels": {"type": "integer", "minimum": 1},
        "trajectoryInterventions": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 1},
        "targetValues": {"type": "integer", "minimum": 0},
        "shards": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "records", "targetValues"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0},
          "records": {"type": "integer", "minimum": 1},
          "targetValues": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "object",
      "required": ["observations", "staticFeatures", "heldInterventionRoster"],
      "properties": {
        "observations": {"$ref": "#/$defs/datasetLineage"},
        "staticFeatures": {"$ref": "#/$defs/datasetLineage"},
        "heldInterventionRoster": {"$ref": "#/$defs/datasetLineage"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "curie": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\s]+$"
    },
    "curieList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/curie"}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prefixedSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "datasetSnapshotUri": {
      "type": "string",
      "pattern": "^omf://[^/\\s]+/[^/\\s]+/datasetsnapshot/[^@/\\s]+@sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:\\s])(?!(?:\\.{1,2})(?:/|$))[^/\\\\:\\s]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:\\s]+)*$"
    },
    "fileReference": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "count"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "possiblyEmptyFileReference": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "count"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "datasetSnapshot": {
      "type": "object",
      "required": ["resource", "revision", "outerManifestDigest", "treeDigest"],
      "properties": {
        "resource": {"$ref": "#/$defs/datasetSnapshotUri"},
        "revision": {"$ref": "#/$defs/prefixedSha256"},
        "outerManifestDigest": {"$ref": "#/$defs/prefixedSha256"},
        "treeDigest": {"$ref": "#/$defs/prefixedSha256"}
      },
      "additionalProperties": false
    },
    "lineageFile": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "datasetLineage": {
      "type": "object",
      "required": ["datasetSnapshot", "semanticSha256", "files"],
      "properties": {
        "datasetSnapshot": {"$ref": "#/$defs/datasetSnapshot"},
        "semanticSha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lineageFile"}
        }
      },
      "additionalProperties": false
    },
    "featureBlock": {
      "type": "object",
      "required": [
        "id",
        "offset",
        "dimension",
        "datasetSnapshot",
        "semanticSha256",
        "entityKeySetSha256",
        "files"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/curie"},
        "offset": {"type": "integer", "minimum": 0},
        "dimension": {"type": "integer", "minimum": 1},
        "datasetSnapshot": {"$ref": "#/$defs/datasetSnapshot"},
        "semanticSha256": {"$ref": "#/$defs/sha256"},
        "entityKeySetSha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lineageFile"}
        }
      },
      "additionalProperties": false
    },
    "staticFeaturePack": {
      "type": "object",
      "required": [
        "schema",
        "revision",
        "sha256",
        "entityFeatureDim",
        "speciesFeatureDim",
        "blocks"
      ],
      "properties": {
        "schema": {"const": "slp.static-feature-pack/v1"},
        "revision": {"$ref": "#/$defs/curie"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "entityFeatureDim": {"type": "integer", "minimum": 1},
        "speciesFeatureDim": {"type": "integer", "minimum": 1},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/featureBlock"}
        }
      },
      "additionalProperties": false
    },
    "covariateList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "unit", "access"],
        "properties": {
          "id": {"$ref": "#/$defs/curie"},
          "unit": {"$ref": "#/$defs/curie"},
          "access": {"enum": ["world", "likelihood", "audit"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
