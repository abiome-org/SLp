{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.abiome.org/slp/molecular-evaluation/v1",
  "title": "SLp molecular evaluation snapshot manifest",
  "type": "object",
  "required": [
    "schema",
    "datasetId",
    "version",
    "role",
    "labelClass",
    "benchmarkLabelsPresent",
    "valueSpace",
    "speciesTaxa",
    "sourceIds",
    "sourceSnapshotSha256",
    "shards"
  ],
  "properties": {
    "schema": {"const": "slp.molecular-evaluation/v1"},
    "datasetId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "role": {
      "enum": ["molecular-reference", "molecular-validation-predictions"]
    },
    "labelClass": {"const": "molecular"},
    "benchmarkLabelsPresent": {"const": false},
    "valueSpace": {"type": "string", "minLength": 1},
    "speciesTaxa": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^.+:.+$"}
    },
    "sourceSnapshotSha256": {"$ref": "#/$defs/sha256"},
    "modelCheckpointSha256": {"$ref": "#/$defs/sha256"},
    "referenceManifestSha256": {"$ref": "#/$defs/sha256"},
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shard"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"role": {"const": "molecular-validation-predictions"}},
        "required": ["role"]
      },
      "then": {
        "required": ["modelCheckpointSha256", "referenceManifestSha256"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["modelCheckpointSha256"]},
            {"required": ["referenceManifestSha256"]}
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shard": {
      "type": "object",
      "required": ["path", "sha256", "records"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:jsonl|jsonl\\.gz)$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "records": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "profileRecord": {
      "type": "object",
      "required": [
        "speciesTaxon",
        "sourceId",
        "centeringGroup",
        "perturbationId",
        "interventionIds",
        "readoutIds",
        "target"
      ],
      "properties": {
        "speciesTaxon": {"type": "integer", "minimum": 1},
        "sourceId": {"type": "string", "pattern": "^.+:.+$"},
        "centeringGroup": {"type": "string", "minLength": 1},
        "perturbationId": {"type": "string", "pattern": "^.+:.+$"},
        "interventionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^.+:.+$"}
        },
        "readoutIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^.+:.+$"}
        },
        "target": {
          "type": "array",
          "minItems": 1,
          "items": {"type": ["number", "null"]}
        },
        "predictionMean": {
          "type": "array",
          "minItems": 1,
          "items": {"type": ["number", "null"]}
        },
        "predictionLogScale": {
          "type": "array",
          "minItems": 1,
          "items": {"type": ["number", "null"]}
        }
      },
      "additionalProperties": false
    }
  }
}
