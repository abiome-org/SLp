{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abiome.org/schemas/slp-corpus-v1.schema.json",
  "title": "SLp molecular corpus snapshot",
  "type": "object",
  "required": [
    "schema",
    "datasetId",
    "version",
    "role",
    "labelClass",
    "benchmarkLabelsPresent",
    "speciesTaxa",
    "modalities",
    "trajectoryGenes",
    "shards"
  ],
  "properties": {
    "schema": {"const": "slp.corpus/v1"},
    "datasetId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "role": {
      "enum": ["pretrain", "molecular-validation", "molecular-reward", "molecular-final"]
    },
    "labelClass": {"const": "molecular"},
    "benchmarkLabelsPresent": {"const": false},
    "speciesTaxa": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "trajectoryGenes": {"$ref": "#/$defs/relativePath"},
    "entityFeatureDim": {"type": "integer", "minimum": 1},
    "speciesFeatureDim": {"type": "integer", "minimum": 1},
    "readoutTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "records"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "records": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  },
  "additionalProperties": false
}
