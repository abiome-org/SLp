{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abiome-org.github.io/OpenModelFactory/schemas/slp-molecular-evaluation-v2.schema.json",
  "title": "SLp molecular evaluator v2 target-separated typed-distribution contract",
  "oneOf": [
    {"$ref": "#/$defs/centeringManifest"},
    {"$ref": "#/$defs/truthManifest"},
    {"$ref": "#/$defs/predictionManifest"},
    {"$ref": "#/$defs/centeringOrTruthRecord"},
    {"$ref": "#/$defs/predictionRecord"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pinnedSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[^\\s:]+:[^\\s]+$"},
    "shard": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "records"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^\\\\:]+\\.jsonl(?:\\.gz)?$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "records": {"type": "integer", "minimum": 1, "maximum": 2000000}
      },
      "additionalProperties": false
    },
    "commonManifestProperties": {
      "schema": {"const": "slp.molecular-evaluation/v2"},
      "datasetId": {"type": "string", "minLength": 1},
      "version": {"type": "string", "minLength": 1},
      "valueSpace": {"type": "string", "minLength": 1},
      "benchmarkLabelsPresent": {"const": false},
      "speciesTaxa": {"const": [4932]},
      "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
      "shards": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/shard"}}
    },
    "centeringManifest": {
      "allOf": [
        {"type": "object", "properties": {"schema": {"const": "slp.molecular-evaluation/v2"}, "datasetId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "benchmarkLabelsPresent": {"const": false}, "valueSpace": {"type": "string", "minLength": 1}, "speciesTaxa": {"const": [4932]}, "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}, "shards": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/shard"}}}},
        {"type": "object", "required": ["schema", "datasetId", "version", "role", "labelClass", "benchmarkLabelsPresent", "valueSpace", "speciesTaxa", "sourceIds", "shards", "fittingOnly"], "properties": {"role": {"const": "molecular-centering-reference"}, "labelClass": {"const": "molecular"}, "fittingOnly": {"const": true}}}
      ],
      "unevaluatedProperties": false
    },
    "truthManifest": {
      "allOf": [
        {"type": "object", "properties": {"schema": {"const": "slp.molecular-evaluation/v2"}, "datasetId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "benchmarkLabelsPresent": {"const": false}, "valueSpace": {"type": "string", "minLength": 1}, "speciesTaxa": {"const": [4932]}, "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}, "shards": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/shard"}}}},
        {"type": "object", "required": ["schema", "datasetId", "version", "role", "labelClass", "benchmarkLabelsPresent", "valueSpace", "speciesTaxa", "sourceIds", "shards", "evaluatorOnly", "queryResource", "queryDatasetManifestDigest", "queryManifestSha256"], "properties": {"role": {"const": "molecular-validation-truth"}, "labelClass": {"const": "molecular"}, "evaluatorOnly": {"const": true}, "queryResource": {"type": "string", "pattern": "^omf://.+/datasetsnapshot/.+@sha256:[0-9a-f]{64}$"}, "queryDatasetManifestDigest": {"$ref": "#/$defs/pinnedSha256"}, "queryManifestSha256": {"$ref": "#/$defs/sha256"}}}
      ],
      "unevaluatedProperties": false
    },
    "predictionManifest": {
      "allOf": [
        {"type": "object", "properties": {"schema": {"const": "slp.molecular-evaluation/v2"}, "datasetId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "benchmarkLabelsPresent": {"const": false}, "valueSpace": {"type": "string", "minLength": 1}, "speciesTaxa": {"const": [4932]}, "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}, "shards": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/shard"}}}},
        {"type": "object", "required": ["schema", "datasetId", "version", "role", "labelClass", "benchmarkLabelsPresent", "valueSpace", "speciesTaxa", "sourceIds", "shards", "modelCheckpointContentSha256", "queryResource", "queryDatasetManifestDigest", "queryManifestSha256", "targetValuesPresent", "observedMaskPresent"], "properties": {"role": {"const": "molecular-validation-predictions"}, "labelClass": {"const": "none"}, "modelCheckpointContentSha256": {"$ref": "#/$defs/sha256"}, "queryResource": {"type": "string", "pattern": "^omf://.+/datasetsnapshot/.+@sha256:[0-9a-f]{64}$"}, "queryDatasetManifestDigest": {"$ref": "#/$defs/pinnedSha256"}, "queryManifestSha256": {"$ref": "#/$defs/sha256"}, "targetValuesPresent": {"const": false}, "observedMaskPresent": {"const": false}}}
      ],
      "unevaluatedProperties": false
    },
    "commonRecordProperties": {
      "profileId": {"type": "string", "pattern": "^PROFILE:[0-9a-f]{64}$"},
      "speciesTaxon": {"const": 4932},
      "sourceId": {"$ref": "#/$defs/stableId"},
      "centeringGroup": {"type": "string", "minLength": 1},
      "perturbationId": {"type": "string", "pattern": "^PERTURBATION:[0-9a-f]{64}$"},
      "interventionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SGD:S[0-9]{9}$"}},
      "readoutIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
      "distributionTypes": {"type": "array", "minItems": 1, "items": {"enum": ["gaussian", "negative-binomial"]}}
    },
    "centeringOrTruthRecord": {
      "allOf": [
        {"type": "object", "properties": {"profileId": {"type": "string", "pattern": "^PROFILE:[0-9a-f]{64}$"}, "speciesTaxon": {"const": 4932}, "sourceId": {"$ref": "#/$defs/stableId"}, "centeringGroup": {"type": "string", "minLength": 1}, "perturbationId": {"type": "string", "pattern": "^PERTURBATION:[0-9a-f]{64}$"}, "interventionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SGD:S[0-9]{9}$"}}, "readoutIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}, "distributionTypes": {"type": "array", "minItems": 1, "items": {"enum": ["gaussian", "negative-binomial"]}}}},
        {"type": "object", "required": ["profileId", "speciesTaxon", "sourceId", "centeringGroup", "perturbationId", "interventionIds", "readoutIds", "distributionTypes", "target"], "properties": {"target": {"type": "array", "minItems": 1, "items": {"type": ["number", "null"]}}}}
      ],
      "unevaluatedProperties": false
    },
    "gaussian": {
      "type": "object", "required": ["mean", "logScale"],
      "properties": {"mean": {"type": "number"}, "logScale": {"type": "number"}},
      "additionalProperties": false
    },
    "negativeBinomial": {
      "type": "object", "required": ["logMean", "logInverseDispersion"],
      "properties": {"logMean": {"type": "number"}, "logInverseDispersion": {"type": "number"}},
      "additionalProperties": false
    },
    "predictionRecord": {
      "allOf": [
        {"type": "object", "properties": {"profileId": {"type": "string", "pattern": "^PROFILE:[0-9a-f]{64}$"}, "speciesTaxon": {"const": 4932}, "sourceId": {"$ref": "#/$defs/stableId"}, "centeringGroup": {"type": "string", "minLength": 1}, "perturbationId": {"type": "string", "pattern": "^PERTURBATION:[0-9a-f]{64}$"}, "interventionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SGD:S[0-9]{9}$"}}, "readoutIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}}, "distributionTypes": {"type": "array", "minItems": 1, "items": {"enum": ["gaussian", "negative-binomial"]}}}},
        {"type": "object", "required": ["profileId", "speciesTaxon", "sourceId", "centeringGroup", "perturbationId", "interventionIds", "readoutIds", "distributionTypes", "predictionParameters"], "properties": {"predictionParameters": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/gaussian"}, {"$ref": "#/$defs/negativeBinomial"}]}}}}
      ],
      "unevaluatedProperties": false
    }
  }
}
