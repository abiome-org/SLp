{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abiome.org/schemas/slp-corpus-audit-v1-2.schema.json",
  "title": "SLp corpus audit v1.2",
  "type": "object",
  "required": [
    "schema", "rewardEnabled", "auditPassed", "strictInterventionIsolation",
    "leakageViolations", "leakedTrajectoryGenes", "benchmarkLabelRecords",
    "omfPriorAdmissionRequired", "datasets", "heldRoster"
  ],
  "properties": {
    "schema": {"const": "slp.corpus-audit/v1.2"},
    "rewardEnabled": {"const": false},
    "auditPassed": {"const": true},
    "strictInterventionIsolation": {"const": true},
    "leakageViolations": {"const": 0},
    "leakedTrajectoryGenes": {"const": []},
    "benchmarkLabelRecords": {"const": 0},
    "omfPriorAdmissionRequired": {"const": true},
    "datasets": {
      "type": "object",
      "required": ["pretrain", "molecularValidation", "molecularFinal"],
      "properties": {
        "pretrain": {"$ref": "#/$defs/corpusIdentity"},
        "molecularValidation": {"$ref": "#/$defs/corpusIdentity"},
        "molecularFinal": {"$ref": "#/$defs/corpusIdentity"}
      },
      "additionalProperties": false
    },
    "heldRoster": {"$ref": "#/$defs/heldRosterIdentity"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "curie": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\s]+$"},
    "curieList": {
      "type": "array", "items": {"$ref": "#/$defs/curie"}, "uniqueItems": true
    },
    "corpusIdentity": {
      "type": "object",
      "required": [
        "resource", "revision", "manifestDigest", "datasetId", "version", "role",
        "corpusManifestSha256", "contentDigest", "trajectoryGenesSha256",
        "trajectoryGeneSetSha256", "trajectoryGeneCount", "records", "targetValues",
        "modalities", "sourceIds", "speciesTaxa"
      ],
      "properties": {
        "resource": {"type": "string", "pattern": "^omf://.+/datasetsnapshot/.+@sha256:[0-9a-f]{64}$"},
        "revision": {"$ref": "#/$defs/prefixedSha256"},
        "manifestDigest": {"$ref": "#/$defs/prefixedSha256"},
        "datasetId": {"$ref": "#/$defs/curie"},
        "version": {"type": "string", "minLength": 1},
        "role": {"enum": ["pretrain", "molecular-validation", "molecular-final"]},
        "corpusManifestSha256": {"$ref": "#/$defs/sha256"},
        "contentDigest": {"$ref": "#/$defs/sha256"},
        "trajectoryGenesSha256": {"$ref": "#/$defs/sha256"},
        "trajectoryGeneSetSha256": {"$ref": "#/$defs/sha256"},
        "trajectoryGeneCount": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 1},
        "targetValues": {"type": "integer", "minimum": 1},
        "modalities": {"$ref": "#/$defs/curieList"},
        "sourceIds": {"$ref": "#/$defs/curieList"},
        "speciesTaxa": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "sourceInventory": {
      "type": "object",
      "required": [
        "resource", "revision", "artifactManifestDigest", "sourceId", "sourceRelease", "identityMappingId", "identityMappingSha256",
        "manifestSha256", "records", "duplicateRecords", "uniqueInterventions",
        "qcPassing", "qcFailed", "intersectionCoverage"
      ],
      "properties": {
        "resource": {"type": "string", "pattern": "^omf://.+/datasetsnapshot/.+@sha256:[0-9a-f]{64}$"},
        "revision": {"$ref": "#/$defs/prefixedSha256"},
        "artifactManifestDigest": {"$ref": "#/$defs/prefixedSha256"},
        "sourceId": {"$ref": "#/$defs/curie"},
        "sourceRelease": {"type": "string", "minLength": 1},
        "identityMappingId": {"$ref": "#/$defs/curie"},
        "identityMappingSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "records": {"type": "integer", "minimum": 0},
        "duplicateRecords": {"type": "integer", "minimum": 0},
        "uniqueInterventions": {"type": "integer", "minimum": 0},
        "qcPassing": {"type": "integer", "minimum": 0},
        "qcFailed": {"type": "integer", "minimum": 0},
        "intersectionCoverage": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "heldRosterIdentity": {
      "type": "object",
      "required": [
        "resource", "revision", "manifestDigest", "rosterSha256", "coverageSha256",
        "assignmentDomainHex", "bucketRule", "identityMappingId", "identityMappingSha256",
        "sourceInventories", "intersectionSize", "pretrainGeneCount",
        "validationGeneSetSha256", "validationGeneCount", "finalGeneSetSha256",
        "finalGeneCount", "unionGeneSetSha256", "unionGeneCount"
      ],
      "properties": {
        "resource": {"type": "string", "pattern": "^omf://.+/datasetsnapshot/.+@sha256:[0-9a-f]{64}$"},
        "revision": {"$ref": "#/$defs/prefixedSha256"},
        "manifestDigest": {"$ref": "#/$defs/prefixedSha256"},
        "rosterSha256": {"$ref": "#/$defs/sha256"},
        "coverageSha256": {"$ref": "#/$defs/sha256"},
        "assignmentDomainHex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "bucketRule": {"const": "int(first-16-lowercase-hex,16) mod 100"},
        "identityMappingId": {"$ref": "#/$defs/curie"},
        "identityMappingSha256": {"$ref": "#/$defs/sha256"},
        "sourceInventories": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/sourceInventory"}},
        "intersectionSize": {"type": "integer", "minimum": 1},
        "pretrainGeneCount": {"type": "integer", "minimum": 0},
        "validationGeneSetSha256": {"$ref": "#/$defs/sha256"},
        "validationGeneCount": {"type": "integer", "minimum": 1},
        "finalGeneSetSha256": {"$ref": "#/$defs/sha256"},
        "finalGeneCount": {"type": "integer", "minimum": 1},
        "unionGeneSetSha256": {"$ref": "#/$defs/sha256"},
        "unionGeneCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
