{
  "name": "slp-corpus-prep",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-12",
  "account_id": "5b7019b38a2b1c0ce119ecf64e92fd92",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{"binding": "CORPUS", "bucket_name": "abiome-artifacts"}],
  "containers": [{"class_name": "CorpusPrep", "image": "./Dockerfile", "max_instances": 1, "instance_type": "standard-2"}],
  "durable_objects": {"bindings": [{"class_name": "CorpusPrep", "name": "PREP"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CorpusPrep"]}]
}
