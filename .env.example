# Existing RunPod campaigns use this; cloud source ingestion does not need a GPU.
RUNPOD_API_KEY=
# Private SLp cloud-storage service. Provisioned secrets belong only in .env.
SLP_STORAGE_URL=
SLP_STORAGE_TOKEN=
# Optional native S3 clients on cloud training/ingestion hosts:
SLP_R2_ACCESS_KEY_ID=
SLP_R2_SECRET_ACCESS_KEY=
