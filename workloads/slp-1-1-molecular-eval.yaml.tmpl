# Template only: render after the prediction, checkpoint, and five independently
# admitted DatasetSnapshots are frozen.
apiVersion: omf.dev/v1alpha1
kind: WorkloadSpec
metadata:
  name: slp-1-1-molecular-eval-v2-frozen
spec:
  evaluationRefs:
    - evaluationspec/slp-1-1-molecular-artifact
  graph:
    stages:
      - name: molecular
        module: modules/slp-1-1-molecular-eval/module.yaml
        operation: run
        inputs:
          molecularCenteringReference: "@@MOLECULAR_CENTERING_DATASET@@"
          molecularPredictions: "@@MOLECULAR_PREDICTIONS_ARTIFACT@@"
          molecularTruth: "@@MOLECULAR_TRUTH_DATASET@@"
          molecularQuery: "@@MOLECULAR_QUERY_DATASET@@"
          corpusAudit: "@@CORPUS_AUDIT_DATASET@@"
          heldRoster: "@@HELD_ROSTER_DATASET@@"
          modelCheckpoint: "@@MODEL_CHECKPOINT@@"
        config:
          expectedQueryResource: "@@MOLECULAR_QUERY_RESOURCE@@"
          expectedQueryDatasetManifestDigest: "@@MOLECULAR_QUERY_MANIFEST_DIGEST@@"
          minimumReferencePerturbations: 2
          minimumProfileReadouts: 2
          maxLineBytes: 16777216
          maximumAbsoluteLogScale: 20.0
        outputs:
          - evaluationSummary
          - evaluationReportSha256
          - molecularTargets
          - profileCount
          - ordinaryPearson
          - perturbedCentroidPearson
          - perturbedCentroidCosine
          - centroidAccuracyCommonPanel
          - minimumSpeciesPerturbedCentroidPearson
          - benchmarkLabelRecords
          - centeringHeldInterventionOverlap
          - strictCorpusAuditPassed
          - heldRosterValidationMatch
          - exactTargetFreeQueryManifest
          - exactProfilePanelJoin
          - diagnosticPassed
          - compatibilityPassed
          - molecularEvaluationReport
