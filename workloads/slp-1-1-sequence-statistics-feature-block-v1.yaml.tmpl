# Outcome-blind static sequence baseline. OMF pins each dataset/name reference
# at admission; the self-contained module separately checks the exact revision,
# outer manifest, tree identity, and every payload digest.
apiVersion: omf.dev/v1alpha1
kind: WorkloadSpec
metadata:
  name: slp-1-1-sequence-statistics-feature-block-v1
spec:
  graph:
    stages:
      - name: build
        module: modules/slp-1-1-sequence-statistics-feature-block-v1/module.yaml
        operation: run
        inputs:
          staticEntityUniverse: dataset/slp-1-1-static-entity-universe-v1
          sgdProteinSequences: dataset/slp-1-1-sgd-protein-sequences-r64-5-1
          sgdCurrentOrfs: artifact:sha256:e67f0e8773feae108ecdb687139885e01ca972ff4aec95cd1358b33db1ea1192
          sgdMappingManifest: artifact:sha256:c74ea81ce604357b998e5f09130dff85bf8a7a26504b9b2426f8038608c52d9c
        config:
          maxManifestBytes: 1048576
          maxLineBytes: 16384
          maxFastaBytes: 16777216
          maxSequenceLength: 100000
          maxRecords: 20000
          maxArchiveBytes: 67108864
        outputs:
          - auditSummary
          - archiveSha256
          - auditSha256
          - manifestSha256
          - entityRowsSha256
          - valuesNpySha256
          - presentNpySha256
          - sequenceProvenanceSha256
          - excludedNonCurrentSha256
          - featureDefinitionSha256
          - entityKeySetSha256
          - rows
          - featureDimension
          - presentValues
          - excludedNonCurrentSequences
          - currentOrfsOutsideUniverse
          - multiTargetProteinConsensus
          - sequenceStatisticsFeatureBlock
          - sequenceStatisticsFeatureBlockAudit
