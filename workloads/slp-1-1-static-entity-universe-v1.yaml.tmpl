# Identity-only workload template. It deliberately has no held-roster,
# observation, benchmark, reward, or feature input. OMF pins each supported
# dataset/name reference at admission; the module enforces the exact revision.
apiVersion: omf.dev/v1alpha1
kind: WorkloadSpec
metadata:
  name: slp-1-1-static-entity-universe-v1
spec:
  graph:
    stages:
      - name: build
        module: modules/slp-1-1-static-entity-universe-v1/module.yaml
        operation: run
        inputs:
          interventionInventory: dataset/slp-1-1-proteome-intervention-inventory-v1
          proteinRelations: dataset/slp-1-1-proteome-protein-relations-v1
        config:
          maxManifestBytes: 1048576
          maxLineBytes: 16384
          maxInterventionRecords: 10000
          maxRelationRecords: 10000
          maxArchiveBytes: 67108864
        outputs:
          - auditSummary
          - archiveSha256
          - auditSha256
          - manifestSha256
          - entitySetSha256
          - relationSetSha256
          - actionIdSetSha256
          - proteinIdSetSha256
          - relationEdgeSetSha256
          - fullEntityIdSetSha256
          - fullEntityKeySetSha256
          - actionEntities
          - readoutQueryEntities
          - totalEntities
          - relationRecords
          - relationEdges
          - relationTargetGenes
          - relationTargetsInUniverse
          - relationSupportOnly
          - oneToManyRelations
          - staticEntityUniverse
          - staticEntityUniverseAudit
