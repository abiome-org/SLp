# Identity-only workload template. It deliberately has no held-roster,
# observation, benchmark, reward, or feature input and defines no aliases.
apiVersion: omf.dev/v1alpha1
kind: WorkloadSpec
metadata:
  name: slp-1-1-static-entity-universe-v1
spec:
  graph:
    stages:
      - name: build
        module: modules/slp-1-1-static-entity-universe-v1/module.yaml
        operation: run
        inputs:
          interventionInventory: "omf://abiome/slp/datasetsnapshot/slp-1-1-proteome-intervention-inventory-v1@sha256:bd688dffdf4d96c01d4147580b1a8705c2149acadbc843a719537817a74505d9"
          proteinRelations: "omf://abiome/slp/datasetsnapshot/slp-1-1-proteome-protein-relations-v1@sha256:acad3427907644f8ab8af38ed36066a6e1148ef92557b727351b0a4fba2b446c"
        config:
          maxManifestBytes: 1048576
          maxLineBytes: 16384
          maxInterventionRecords: 10000
          maxRelationRecords: 10000
          maxArchiveBytes: 67108864
        outputs:
          - auditSummary
          - archiveSha256
          - auditSha256
          - manifestSha256
          - entitySetSha256
          - relationSetSha256
          - actionIdSetSha256
          - proteinIdSetSha256
          - relationEdgeSetSha256
          - fullEntityIdSetSha256
          - fullEntityKeySetSha256
          - actionEntities
          - readoutQueryEntities
          - totalEntities
          - relationRecords
          - relationEdges
          - relationTargetGenes
          - relationTargetsInUniverse
          - relationSupportOnly
          - oneToManyRelations
          - staticEntityUniverse
          - staticEntityUniverseAudit
